# ---------------------------------------------------------------------------
# Personal trade data. NOTHING under private/ is ever published.
#
# It holds the real broker export, the journal database, the forensic analysis
# of it, and the tests that assert against real figures. One rule, so there is
# no pattern list to get wrong.
# ---------------------------------------------------------------------------
/private/

# Journals anywhere else (a stray --db path, a scratch copy).
*.db
*.db-wal
*.db-shm

# Broker exports anywhere else. Test fixtures are synthetic and explicitly
# re-included below.
*.csv
!tests/fixtures/*.csv

/data/
docker/data/

__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/

.coverage
htmlcov/
.pytest_cache/
.DS_Store
